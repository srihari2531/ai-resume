# ==========================================
# Byte-compiled / optimized / Python cache
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# ==========================================
# Virtual Environments
# ==========================================
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
.env/

# ==========================================
# Environment Variables & Secrets (CRITICAL)
# ==========================================
.env
.env.local
.env.*.local
*.env
!.env.example

# ==========================================
# Streamlit Configuration & Secrets
# ==========================================
# Keep config.toml and secrets.toml.example tracked, ignore actual secrets
.streamlit/secrets.toml
!.streamlit/config.toml
!.streamlit/secrets.toml.example

# ==========================================
# Temporary, Log, and Scratch Files
# ==========================================
*.log
scratch/
temp/
tmp/
uploads/
*.tmp

# ==========================================
# IDEs and Editors
# ==========================================
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ==========================================
# OS Generated Files
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ==========================================
# Packaging & Distribution
# ==========================================
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
